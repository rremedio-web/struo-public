{
    "name": "struo/struo",
    "description": "Safe, allowlisted AI block editing for WordPress.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13.6",
        "wp-coding-standards/wpcs": "^3.4.1",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Struo\\": "src/"
        }
    },
    "scripts": {
        "lint": "phpcs --standard=phpcs.xml.dist",
        "lint:godclass": "phpcs -d memory_limit=1G --standard=phpcs.xml.dist --report=summary --report-source struo.php",
        "test": "php tests/provider-url-cases.php && php tests/rate-limit-cases.php && php tests/plugin-entry-deactivate-cases.php && php tests/durable-plan-store-cases.php",
        "smoke": "bash tests/smoke.sh"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true }
    }
}
